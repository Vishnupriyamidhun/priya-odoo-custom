<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <!--
        Ee module-inte "Currently Working" dashboard-il ella employees-inteyum
        running timer kaanan, ee moonu groups-ilulla users-kku
        account.analytic.line-inte ELLA records-um kaanan explicit-ayi
        access kodukkunnu. Ith self-contained aanu - vere ethenkilum
        module-il "Timesheets access right" manual-ayi maattendathilla,
        ee rule thanne mathi.

        Odoo-yude ir.rule semantics: group ullore rules, same model-inte
        vere group-rules-ode OR ayi combine cheyyum. Athukondu, ee
        three groups-il ethenkilum onnil ulla oral-kku ee rule
        (domain: ella records-um) automatic-ayi apply aakum -
        avarude nilavilulla "Own timesheets only" / "Approve Timesheets"
        setting enthaayirunnalum.
    -->
    <record id="account_analytic_line_rule_currently_working_visibility" model="ir.rule">
        <field name="name">
            Project Managers/Approvers/Admins can see all running
            timesheet lines (Currently Working dashboard)
        </field>
        <field name="model_id" ref="analytic.model_account_analytic_line" />
        <field name="domain_force">[(1, '=', 1)]</field>
        <field
            name="groups"
            eval="[
                (4, ref('project.group_project_manager')),
                (4, ref('hr_timesheet.group_hr_timesheet_approver')),
                (4, ref('base.group_system')),
            ]"
        />
    </record>
</odoo>