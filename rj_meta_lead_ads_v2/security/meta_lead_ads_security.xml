<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="group_meta_lead_ads_user" model="res.groups">
        <field name="name">User</field>
        <field name="category_id" ref="base.module_category_marketing"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>
    <record id="group_meta_lead_ads_manager" model="res.groups">
        <field name="name">Manager</field>
        <field name="category_id" ref="base.module_category_marketing"/>
        <field name="implied_ids" eval="[(4, ref('group_meta_lead_ads_user'))]"/>
        <field name="users" eval="[(4, ref('base.user_admin'))]"/>
    </record>
    <record id="base.group_system" model="res.groups">
        <field name="implied_ids" eval="[(4, ref('group_meta_lead_ads_manager'))]"/>
    </record>
    <record id="meta_lead_ads_config_company_rule" model="ir.rule">
        <field name="name">Meta Lead Ads config multi-company</field>
        <field name="model_id" ref="model_meta_lead_ads_config"/>
        <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
    </record>
    <record id="meta_lead_ads_log_company_rule" model="ir.rule">
        <field name="name">Meta Lead Ads log multi-company</field>
        <field name="model_id" ref="model_meta_lead_ads_api_log"/>
        <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
    </record>
    <record id="meta_lead_ads_biz_company_rule" model="ir.rule">
        <field name="name">Meta Lead Ads records multi-company</field>
        <field name="model_id" ref="model_meta_lead_ads_form"/>
        <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
    </record>
    <record id="meta_lead_ads_leadtrack_company_rule" model="ir.rule">
        <field name="name">Meta Lead Ads imported leads multi-company</field>
        <field name="model_id" ref="model_meta_lead_ads_lead"/>
        <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
    </record>
</odoo>
