<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <!-- Read-only monitoring list: shows every currently-running timesheet
         line (unit_amount == 0) across ALL employees. Meant for
         admins / project managers / timesheet approvers only, so they can
         see who is working right now without being able to start or stop
         anyone else's timer from here. -->
    <record id="view_timesheet_currently_running_tree" model="ir.ui.view">
        <field name="name">account.analytic.line.currently.running.list</field>
        <field name="model">account.analytic.line</field>
        <field name="arch" type="xml">
            <list
                string="Currently Working"
                create="0"
                edit="0"
                delete="0"
                import="0"
                export_xlsx="0"
            >
                <field name="employee_id" />
                <field name="project_id" />
                <field name="task_id" />
                <field name="date_time" string="Started At" />
                <field name="user_id" string="Logged In As" optional="hide" />
            </list>
        </field>
    </record>

    <record id="view_timesheet_currently_running_search" model="ir.ui.view">
        <field name="name">account.analytic.line.currently.running.search</field>
        <field name="model">account.analytic.line</field>
        <field name="arch" type="xml">
            <search string="Currently Working">
                <field name="employee_id" />
                <field name="project_id" />
                <field name="task_id" />
                <filter
                    name="group_employee"
                    string="Employee"
                    context="{'group_by': 'employee_id'}"
                />
                <filter
                    name="group_project"
                    string="Project"
                    context="{'group_by': 'project_id'}"
                />
            </search>
        </field>
    </record>

    <record id="action_timesheet_currently_running" model="ir.actions.act_window">
        <field name="name">Currently Working</field>
        <field name="res_model">account.analytic.line</field>
        <field name="view_mode">list</field>
        <field name="search_view_id" ref="view_timesheet_currently_running_search" />
        <field
            name="domain"
        >[('unit_amount', '=', 0), ('task_id', '!=', False)]</field>
        <field name="context">{}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No one is currently working on a task.
            </p>
        </field>
    </record>

    <!--
        Visible only to: Administrators (base.group_system), Project
        Managers (project.group_project_manager), and users with
        "Manager: Approve Timesheets" access (hr_timesheet.group_hr_timesheet_approver).

        Record visibility for these same three groups is guaranteed by
        our own rule in security/account_analytic_line_security.xml -
        it does not depend on each user's individual "Timesheets access
        right" setting elsewhere in Odoo. Anyone in one of these three
        groups automatically sees every employee's running line here.
    -->
    <menuitem
        id="menu_timesheet_currently_running"
        name="Currently Working"
        parent="project.menu_main_pm"
        action="action_timesheet_currently_running"
        sequence="100"
        groups="project.group_project_manager,hr_timesheet.group_hr_timesheet_approver,base.group_system"
    />
</odoo>