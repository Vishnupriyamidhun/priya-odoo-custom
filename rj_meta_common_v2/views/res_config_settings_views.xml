<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form_meta_common" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.meta.common</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="website.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//block[@id='website_settings']" position="after">
                <block title="Meta Common Panel" id="meta_common_panel_settings" invisible="not website_id">
                    <setting id="meta_common_panel_enable"
                             string="Meta Side Panel on Website"
                             help="Floating Meta console panel on every page (Business Suite, Ads, Events…).">
                        <field name="has_meta_common_panel"/>
                        <div class="content-group" invisible="not has_meta_common_panel">
                            <div class="row mt16">
                                <label class="col-lg-3 o_light_label" for="meta_panel_label" string="Button Label"/>
                                <field name="meta_panel_label"/>
                            </div>
                            <div class="row">
                                <label class="col-lg-3 o_light_label" for="meta_panel_position" string="Position"/>
                                <field name="meta_panel_position"/>
                            </div>
                            <div class="row">
                                <label class="col-lg-3 o_light_label" for="meta_panel_open_mode" string="Open Mode"/>
                                <field name="meta_panel_open_mode"/>
                            </div>
                            <div class="row">
                                <label class="col-lg-3 o_light_label" for="meta_panel_default_screen" string="Default Screen"/>
                                <field name="meta_panel_default_screen"/>
                            </div>
                            <div class="row">
                                <label class="col-lg-3 o_light_label" for="meta_panel_show_on_mobile" string="Show on Mobile"/>
                                <field name="meta_panel_show_on_mobile"/>
                            </div>
                            <div class="row">
                                <label class="col-lg-3 o_light_label" for="meta_panel_require_editor" string="Editors Only"/>
                                <field name="meta_panel_require_editor"/>
                            </div>
                            <div class="row mt8">
                                <label class="col-lg-3 o_light_label" for="meta_url_business_suite" string="Business Suite"/>
                                <field name="meta_url_business_suite"/>
                            </div>
                            <div class="row">
                                <label class="col-lg-3 o_light_label" for="meta_url_ads_manager" string="Ads Manager"/>
                                <field name="meta_url_ads_manager"/>
                            </div>
                            <div class="row">
                                <label class="col-lg-3 o_light_label" for="meta_url_events_manager" string="Events Manager"/>
                                <field name="meta_url_events_manager"/>
                            </div>
                            <div class="row">
                                <label class="col-lg-3 o_light_label" for="meta_url_commerce" string="Commerce"/>
                                <field name="meta_url_commerce"/>
                            </div>
                            <div class="row">
                                <label class="col-lg-3 o_light_label" for="meta_url_whatsapp" string="WhatsApp"/>
                                <field name="meta_url_whatsapp"/>
                            </div>
                            <div class="row">
                                <label class="col-lg-3 o_light_label" for="meta_url_custom" string="Custom URL"/>
                                <field name="meta_url_custom"/>
                            </div>
                        </div>
                    </setting>
                </block>
            </xpath>
        </field>
    </record>
</odoo>
